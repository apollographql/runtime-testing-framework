A YAML fragment for a command that references multiple files. One is a directory
rather than a file. The other is a file that does not exist. This should parse
but fail to validate.

-- config.yaml --
command: "scripts/curl_get_test.sh"

env_vars:
  AUTH_HEADER: "{{ credentials_env_var }}"
  SERVER_URL: "{{ server_url }}"

file_providers:
  - name: "is-a-directory.txt"
    env_var: IS_A_DIRECTORY
    kind: relative_path
    path: ../../../provider-tests
