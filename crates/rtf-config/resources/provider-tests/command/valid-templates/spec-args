A valid yaml fragment for a command section that successfully
templates the command args

-- config.yaml --
command: 
  name: inline-command.txt
  kind: inline
  content: |
      This is some inline file content
      split over multiple lines.
      How nice.
  args:
    - "arg1"
    - "{{ arg2 }}"

-- values --
arg2: "arg2_value"

-- after-templating --
command: 
  name: inline-command.txt
  kind: inline
  content: |
      This is some inline file content
      split over multiple lines.
      How nice.
  args:
    - "arg1"
    - "arg2_value"
