A valid yaml fragment for a graphos subgraph router url overrides file provider that uses
a template for the graph ref

-- config.yaml --
kind: graphos_subgraph_router_url_overrides
graph_ref: "{{ graph_ref }}"

-- values --
graph_ref: "graph_id@variant"

-- after-templating --
kind: graphos_subgraph_router_url_overrides
graph_ref: "graph_id@variant"
url_format: "localhost"
