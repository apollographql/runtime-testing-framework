A valid yaml fragment for a graphos subgraph docker compose file provider that uses
a template for the graph ref

-- config.yaml --
kind: graphos_subgraph_docker_compose
graph_ref: "{{ graph_ref }}"

-- values --
graph_ref: "graph_id@variant"

-- after-templating --
kind: graphos_subgraph_docker_compose
graph_ref: "graph_id@variant"
image: "ghcr.io/apollographql/runtime-testing-framework/router-scale-subgraph:main"
command:
  - "-schema"
  - "/app/supergraph.graphql"
resource_limits:
  cpus: "0.1"
  memory: "1G"
resource_reservations:
  cpus: "0.1"
  memory: "512M"
mem_swappiness: 0
