A valid yaml fragment for a github file provider that uses
a templates for all fields

-- config.yaml --
kind: github_file
org: "{{ org }}"
repo: "{{ repo }}"
path: "{{ path }}"
git_ref: "{{ git_ref }}"

-- values --
org: "apollographql"
repo: "runtime-testing-framework"
path: "README.md"
git_ref: "my-branch"

-- after-templating --
kind: github_file
org: "apollographql"
repo: "runtime-testing-framework"
path: "README.md"
git_ref: "my-branch"
