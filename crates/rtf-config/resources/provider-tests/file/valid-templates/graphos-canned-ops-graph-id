A valid yaml fragment for a graphos canned ops file provider that uses
a template for the graph ref

-- config.yaml --
kind: graphos_canned_ops
graph_ref: "{{ graph_ref }}"

-- values --
graph_ref: "graph_id@variant"

-- after-templating --
kind: graphos_canned_ops
graph_ref: "graph_id@variant"
top_n: 20
skip_mutations: false
