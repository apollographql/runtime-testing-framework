A valid yaml fragment for a graphos canned ops file provider that uses
a template for the graph id

-- config.yaml --
kind: graphos_canned_ops
graph_id: "{{ graph_id }}"
variant: "variant"

-- values --
graph_id: "graph_id"

-- after-templating --
kind: graphos_canned_ops
graph_id: "graph_id"
variant: "variant"
top_n: 20
skip_mutations: false
