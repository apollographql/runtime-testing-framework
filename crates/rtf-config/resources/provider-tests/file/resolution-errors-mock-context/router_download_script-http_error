Attempting to download a version of the router that does not
exist should result in a 404 error

-- config.yaml --
kind: router_download_script
version: "v12.25.85"

-- mock-http-requests --
requests:
  - url: "https://router.apollo.dev/download/nix/v12.25.85"
    status: 404
    body: "Unknown router version: v12.25.85"

-- resolution-errors --
Unknown router version: v12.25.85
