A valid yaml fragment for building the router from source containing
only rust_version field

-- config.yaml --
kind: build_router_from_source
rust_version: "1.65.0-nightly.20230701"

-- expected-file-content --
mkdir router-source && \
cd router-source && \
git clone https://github.com/apollographql/router.git && \
cd router && \
git checkout main && \
rustup toolchain install 1.65.0-nightly.20230701 && \
rustup run 1.65.0-nightly.20230701 cargo build --release && \
cp ${CARGO_TARGET_DIR}/release/router ~/.cargo/bin/
