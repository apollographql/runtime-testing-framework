A valid environment config file that uses minimal fields

-- config.yaml --
name: minimal
setup_command:
  local: "../../scripts/deploy-router.sh"

values:
  - name: router_build
    description: "How to fetch or build the desired version of the Router"

parameters:
  foo: "bar"

file_parameters:
  - name: "my-file.txt"
    kind: inline
    content: |
      My inline file content.

provides:
  - name: subgraph_urls
    description: "A map of subgraph names to their override URL"
    schema:
      type: object
      additionalProperties:
        type: string

