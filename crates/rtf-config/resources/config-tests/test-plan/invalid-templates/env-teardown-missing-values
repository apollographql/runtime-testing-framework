A minimal valid test plan config that specifies environment
and scenario configs inline. There are missing values in
the environment teardown required for templating.

-- config.yaml --
name: minimal-test
description: |
  A minimal test plan config

values:
  credentials_env_var: "AUTH_HEADER"
  server_command: "python3 server.py"

scenario:
  name: valid-scenario
  description: |
    A description for a valid scenario

  values:
    - name: foo
      description: "A value foo"
  
  command: "/command.sh"

  env_vars:
    SOME_ENV_VAR: "some_value"

  file_providers:
    - name: "inline.txt"
      env_var: INLINE_FILE
      kind: inline
      content: |
        This is some inline file content
        split over multiple lines.
        How nice.

environment:
  name: minimal
  description: "A minimal environment config"

  values:
    - name: bar
      description: "An env var called bar"
    - name: foo
      description: "An env var called foo"
  
  setup:
    command: scripts/start_local_server.sh
    env_vars:
     HELLO: "world"
  
    provides:
    - name: server_pid
      description: "The PID of the running server"
    - name: server_url
      description: "The publicly accessible URL for the service under test"
    
  teardown:
    command: scripts/stop_local_server.sh
    env_vars:
      HELLO: "{{ missing_value }}"

-- templating-errors --
MissingValues
