A minimal valid test plan config that specifies environment
and scenario configs inline. The provided matrix row is
contains multiple scalar types which is not allowed as values
are strongly typed.

-- config.yaml --
name: minimal-test
description: |
  A minimal test plan config

values:
  server_command: "python3 server.py"

matrix:
  credentials_env_var: [ "AUTH", 42 ]

scenario:
  name: valid-scenario
  description: |
    A description for a valid scenario

  values:
    - name: foo
      description: "A value foo"
  
  command: 
    name: command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, World!"

  file_providers:
    - name: "inline.txt"
      env_var: INLINE_FILE
      kind: inline
      content: |
        This is some inline file content
        split over multiple lines.
        How nice.

environment:
  name: minimal
  description: "A minimal environment config"

  values:
    - name: bar
      description: "An env var called bar"
    - name: foo
      description: "An env var called foo"
  
  setup:
    command:
      name: inline-command.sh
      kind: inline
      content: |
        #!/usr/bin/env sh
        echo "Hello, world!"
    env_vars:
      HELLO: "world"
      AUTH: "{{ credentials_env_var }}"
  
    provides:
    - name: server_pid
      description: "The PID of the running server"
    - name: server_url
      description: "The publicly accessible URL for the service under test"
    
  teardown:
    command:
      name: inline-command.sh
      kind: inline
      content: |
        #!/usr/bin/env sh
        echo "Hello, world!"
    env_vars:
      HELLO: "sailor"

-- templating-errors --
InconsistentMatrixValue
