A valid ConfigSource snippet for an EnvrionmentConfig. This successfully
overrides the values. It is expected that the output values will be
a combination of the inline content and overrides. De-duplication
will happen in separate function.

-- environment.yaml --
name: minimal
description: "A minimal environment config"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"

setup:
  command: scripts/start_local_server.sh
  env_vars:
    HELLO: "world"

  provides:
    - name: server_url
      description: "The publicly accessible URL for the service under test"
    - name: server_pid
      description: "The PID of the running server"

teardown:
  command: scripts/stop_local_server.sh
  env_vars:
    HELLO: "sailor"

-- overrides --
values:
  - name: baz
    description: "An env var called baz"

-- expected-config --
name: minimal
description: "A minimal environment config"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"
  - name: baz
    description: "An env var called baz"

setup:
  command: scripts/start_local_server.sh
  env_vars:
    HELLO: "world"

  provides:
    - name: server_url
      description: "The publicly accessible URL for the service under test"
    - name: server_pid
      description: "The PID of the running server"

teardown:
  command: scripts/stop_local_server.sh
  env_vars:
    HELLO: "sailor"
