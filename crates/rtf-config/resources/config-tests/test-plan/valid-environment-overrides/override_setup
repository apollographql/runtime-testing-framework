A valid ConfigSource snippet for an EnvironmentConfig. This 
successfully overrides the setup. It is expected 
that the env_vars and provides will be a combination of the 
inline and overrides content. De-duplication will happen in 
separate function.

-- environment.yaml --
name: minimal
description: "A minimal environment config"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"

setup:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "world"

  provides:
    - name: server_url
      description: "The publicly accessible URL for the service under test"
    - name: server_pid
      description: "The PID of the running server"

teardown:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "sailor"

-- overrides --
setup:
  command:
    name: override.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, override!"
  env_vars:
    OVER: "ride"

  provides:
    - name: override
      description: "The override description"

-- expected-config --
name: minimal
description: "A minimal environment config"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"

setup:
  command:
    name: override.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, override!"
  env_vars:
    HELLO: "world"
    OVER: "ride"

  provides:
    - name: server_url
      description: "The publicly accessible URL for the service under test"
    - name: server_pid
      description: "The PID of the running server"
    - name: override
      description: "The override description"

teardown:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "sailor"
