A valid ConfigSource snippet for a ScenarioConfig. This successfully
overrides the output_directories. It is expected that the "/results"
directory will be duplicated in the output. De-duplication will
happen in a separate function.

-- scenario.yaml --
name: valid-scenario
description: |
  A description for a valid scenario

values:
  - name: foo
    description: "A value foo"

output_directories:
  - /results

command: "/command.sh"

env_vars:
  SOME_ENV_VAR: "some_env_var"

file_providers:
  - name: "inline.txt"
    env_var: INLINE_FILE
    kind: inline
    content: |
      This is some inline file content
      split over multiple lines.
      How nice.

-- overrides --
output_directories:
  - /results
  - /more-results
-- expected-config --
