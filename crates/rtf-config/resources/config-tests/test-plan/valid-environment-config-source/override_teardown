A valid ConfigSource snippet for an EnvrionmentConfig. This 
successfully overrides the teardown. It is expected 
that the env_vars and provides will be a combination of the 
inline and overrides content. De-duplication will happen in 
separate function.

-- inline-content --
name: minimal
description: "A minimal environment config"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"

setup:
  command: scripts/start_local_server.sh
  env_vars:
    HELLO: "world"

  provides:
    - name: server_url
      description: "The publicly accessible URL for the service under test"
    - name: server_pid
      description: "The PID of the running server"

teardown:
  command: scripts/stop_local_server.sh
  env_vars:
    HELLO: "sailor"

-- overrides --
teardown:
  command: override.sh
  env_vars:
    OVER: "ride"

-- expected-config --
name: minimal
description: "A minimal environment config"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"

setup:
  command: scripts/start_local_server.sh
  env_vars:
    HELLO: "world"

  provides:
    - name: server_url
      description: "The publicly accessible URL for the service under test"
    - name: server_pid
      description: "The PID of the running server"

teardown:
  command: override.sh
  env_vars:
    HELLO: "sailor"
    OVER: "ride"
