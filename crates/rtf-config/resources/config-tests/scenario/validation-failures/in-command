Validation failures in command should be reported

-- config.yaml --
name: valid-scenario
description: |
  A description for a valid scenario

values:
  - name: foo
    description: "A value foo"

command: "/command.sh"

env_vars:
  SOME_ENV_VAR: "some_env_var"

file_providers:
  - name: "should-be-invalid"
    env_var: INVALID
    kind: required
    message: Required files should always fail validation

-- validation-errors --
RequiredFileMissing
