The top level values section should be optional if templating is not being used.

-- config.yaml --
name: valid-scenario
description: |
  A description for a valid scenario

command: "/command.sh"

env_vars:
  SOME_ENV_VAR: "some_env_var"

file_providers:
  - name: "inline.txt"
    env_var: INLINE_FILE
    kind: inline
    content: |
      This is some inline file content
      split over multiple lines.
      How nice.
