The top level env_vars section should be optional.

-- config.yaml --
name: valid-scenario
description: |
  A description for a valid scenario

values:
  - name: foo
    description: "A value foo"

command: 
  name: command.sh
  kind: inline
  content: |
    #!/usr/bin/env sh
    echo "Hello, World!"

file_providers:
  - name: "inline.txt"
    env_var: INLINE_FILE
    kind: inline
    content: |
      This is some inline file content
      split over multiple lines.
      How nice.
