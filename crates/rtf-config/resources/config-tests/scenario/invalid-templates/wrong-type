An value with the wrong type for where it is being templated should be an error.

-- config.yaml --
name: valid-scenario
description: |
  A description for a valid scenario

values:
  - name: foo
    description: "A value foo"

command: 
  name: command.sh
  kind: inline
  content: |
    #!/usr/bin/env sh
    echo "Hello, World!"

file_providers:
  - name: "inline.txt"
    env_var: INLINE_FILE
    kind: inline
    content: |
      This is some inline file content
      split over multiple lines.
      How nice.

  - name: foo
    env_var: FOO
    kind: relative_path
    path: "{{ foo }}"

teardown:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"

-- values --
foo: 42  # paths need to be strings

-- templating-errors --
InvalidData
