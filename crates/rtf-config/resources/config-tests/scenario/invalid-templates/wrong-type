An value with the wrong type for where it is being templated should be an error.

-- config.yaml --
name: valid-scenario
description: |
  A description for a valid scenario

values:
  - name: foo
    description: "A value foo"

command: "/command.sh"

env_vars:
  SOME_ENV_VAR: "{{ foo }}"

file_providers:
  - name: "inline.txt"
    env_var: INLINE_FILE
    kind: inline
    content: |
      This is some inline file content
      split over multiple lines.
      How nice.

teardown:
  command: scripts/stop_local_server.sh

-- values --
foo: 42  # env vars should always be strings

-- templating-errors --
InvalidData
