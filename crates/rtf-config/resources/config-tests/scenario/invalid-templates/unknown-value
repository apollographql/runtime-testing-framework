An unknown value (i.e. not present in values at all) should be an error.

-- config.yaml --
name: valid-scenario
description: |
  A description for a valid scenario

values:
  - name: foo
    description: "A value foo"

output_directories:
  - /results

command: "/command.sh"

env_vars:
  SOME_ENV_VAR: "{{ unknown }}"

file_providers:
  - name: "inline.txt"
    env_var: INLINE_FILE
    kind: inline
    content: |
      This is some inline file content
      split over multiple lines.
      How nice.

-- values --
foo: "bar"

-- templating-errors --
UnknownValue
