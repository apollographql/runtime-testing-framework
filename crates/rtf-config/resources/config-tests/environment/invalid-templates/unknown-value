An unknown value (i.e. not present in values at all) should be an error.

-- config.yaml --
name: minimal-with-templates
description: "A minimal environment config with templates"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"

setup:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "{{ unknown }}"

teardown:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"

-- values --
foo: "bar"

-- templating-errors --
UnknownValue
