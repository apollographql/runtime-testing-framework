An value with the wrong type for where it is being templated should be an error.

-- config.yaml --
name: minimal-with-templates
description: "A minimal environment config with templates"

values:
  - name: foo
    description: "An value called foo"

setup:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  file_providers:
    - name: foo
      env_var: FOO
      kind: relative_path
      path: "{{ foo }}"

teardown:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"

-- values --
foo: 42  # paths need to be strings

-- templating-errors --
InvalidData
