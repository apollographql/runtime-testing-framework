An undeclared value (i.e. present in the provided values map but not in the
values section of the config file) should be an error.

-- config.yaml --
name: minimal-with-templates
description: "A minimal environment config with templates"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"

setup:
  command: scripts/start_local_server.sh
  env_vars:
    HELLO: "{{ undeclared }}"

teardown:
  command: scripts/stop_local_server.sh

-- values --
foo: "bar"
undeclared: "shouldn't template"

-- templating-errors --
UnknownValue
