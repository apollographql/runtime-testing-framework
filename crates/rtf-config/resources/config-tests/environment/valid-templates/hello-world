The "hello, world!" example environment config.

-- config.yaml --
name: env-local-service
description: "Spin up a locally running HTTP server"

values:
  - name: credentials_env_var
    description: "An environment variable that contains a '$user:$pwd' string"
  - name: server_command
    description: "The command to run to start the server"

setup:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "world"
    AUTH_HEADER: "{{ credentials_env_var }}"
    SERVER_COMMAND: "{{ server_command }}"

  provides:
    - name: server_url
      description: "The publicly accessible URL for the service under test"
    - name: server_pid
      description: "The PID of the running server"

teardown:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "sailor"
    SERVER_PID: "{{ server_pid }}"

-- values --
credentials_env_var: "foo:bar"
server_command: "python3 server.py"
server_pid: "123"

