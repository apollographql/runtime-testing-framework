A minimal valid environment config with templating.

-- config.yaml --
name: minimal-with-templates
description: "A minimal environment config with templates"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"

setup:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "{{ foo }}"

teardown:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "{{ foo }}"

-- values --
foo: "bar"

-- after-templating --
