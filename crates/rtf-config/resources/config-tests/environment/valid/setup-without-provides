setup.provides should be optional if there are no values returned from the setup script

-- config.yaml --
name: minimal
description: "A minimal environment config"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"

setup:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "world"

teardown:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "sailor"
