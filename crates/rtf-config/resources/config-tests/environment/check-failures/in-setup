check failures in setup should be reported

-- config.yaml --
name: minimal
description: "A minimal environment config"

values:
  - name: foo
    description: "An env var called foo"
  - name: bar
    description: "An env var called bar"

setup:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "world"

  file_providers:
    - name: "should-be-invalid"
      env_var: INVALID
      kind: required
      message: Required files should always fail checks

  provides:
    - name: server_url
      description: "The publicly accessible URL for the service under test"
    - name: server_pid
      description: "The PID of the running server"

teardown:
  command:
    name: inline-command.sh
    kind: inline
    content: |
      #!/usr/bin/env sh
      echo "Hello, world!"
  env_vars:
    HELLO: "sailor"

-- check-errors --
RequiredFileMissing
