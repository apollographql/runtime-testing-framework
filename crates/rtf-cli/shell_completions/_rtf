#compdef rtf

autoload -U is-at-least

_rtf() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'*--var=[A single additional templating variable in the form "key=value"]:VAR:_default' \
'--vars=[Path to a JSON file containing additional template variables]:VARS:_files' \
'*-v[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'*--verbose[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_rtf_commands" \
"*::: :->rtf" \
&& ret=0
    case $state in
    (rtf)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rtf-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" : \
'()--github=[Execute a test plan file in GitHub instead of from a local path]:ORG/REPO/PATH:_default' \
'--ref=[Optional git ref to pull files from when using --github]:GIT_REF:_default' \
'--outdir=[Output directory for providers when they run]:OUTDIR:_default' \
'*--var=[A single additional templating variable in the form "key=value"]:VAR:_default' \
'--vars=[Path to a JSON file containing additional template variables]:VARS:_files' \
'*-v[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'*--verbose[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'-h[Print help]' \
'--help[Print help]' \
'::test_plan_path -- Relative path to the test plan file that should be executed:_default' \
&& ret=0
;;
(expand-matrix)
_arguments "${_arguments_options[@]}" : \
'*--var=[A single additional templating variable in the form "key=value"]:VAR:_default' \
'--vars=[Path to a JSON file containing additional template variables]:VARS:_files' \
'-c[Return the expanded matrix JSON in compact form]' \
'--compact[Return the expanded matrix JSON in compact form]' \
'*-v[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'*--verbose[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'-h[Print help]' \
'--help[Print help]' \
':test_plan_path -- Relative path to the test-plan.yaml file that should have its matrix expanded:_default' \
&& ret=0
;;
(template)
_arguments "${_arguments_options[@]}" : \
'()--github=[Template a test plan file in GitHub instead of from a local path]:ORG/REPO/PATH:_default' \
'--ref=[Optional git ref to pull files from when using --github]:GIT_REF:_default' \
'*--var=[A single additional templating variable in the form "key=value"]:VAR:_default' \
'--vars=[Path to a JSON file containing additional template variables]:VARS:_files' \
'--check[Run a static check of the resulting test plan after templating]' \
'*-v[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'*--verbose[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'-h[Print help]' \
'--help[Print help]' \
'::test_plan_path -- Relative path to the test-plan.yaml file that should be templated:_default' \
&& ret=0
;;
(custom-provider)
_arguments "${_arguments_options[@]}" : \
'*--var=[A single additional templating variable in the form "key=value"]:VAR:_default' \
'--vars=[Path to a JSON file containing additional template variables]:VARS:_files' \
'*-v[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'*--verbose[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_rtf__custom-provider_commands" \
"*::: :->custom-provider" \
&& ret=0

    case $state in
    (custom-provider)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rtf-custom-provider-command-$line[1]:"
        case $line[1] in
            (template)
_arguments "${_arguments_options[@]}" : \
'*--var=[A single additional templating variable in the form "key=value"]:VAR:_default' \
'--vars=[Path to a JSON file containing additional template variables]:VARS:_files' \
'--check[Run a static check of the resulting test plan after templating]' \
'*-v[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'*--verbose[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'-h[Print help]' \
'--help[Print help]' \
':definition_path -- Relative path to the custom provider definition file:_default' \
&& ret=0
;;
(run)
_arguments "${_arguments_options[@]}" : \
'--outdir=[Output directory for provider execution]:OUTDIR:_default' \
'*--var=[A single additional templating variable in the form "key=value"]:VAR:_default' \
'--vars=[Path to a JSON file containing additional template variables]:VARS:_files' \
'*-v[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'*--verbose[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'-h[Print help]' \
'--help[Print help]' \
':definition_path -- Relative path to the custom provider definition file:_default' \
&& ret=0
;;
(test)
_arguments "${_arguments_options[@]}" : \
'--test-cases-dir=[The directory that contains the test cases]:TEST_CASES_DIR:_default' \
'*--var=[A single additional templating variable in the form "key=value"]:VAR:_default' \
'--vars=[Path to a JSON file containing additional template variables]:VARS:_files' \
'--error-on-empty[Whether or not having zero test cases is considered an error]' \
'--no-capture[Show captured stdout/stderr for failed tests]' \
'*-v[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'*--verbose[Flag to control logging verbosity. Default level is \`warn\`. \`-v\` sets logging level to \`info\`,\`-vv\` to \`debug\` and \`-vvv\` to \`trace\`]' \
'-h[Print help]' \
'--help[Print help]' \
':definition_path -- Relative path to the custom provider definition file:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_rtf__custom-provider__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rtf-custom-provider-help-command-$line[1]:"
        case $line[1] in
            (template)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(run)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(test)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_rtf__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rtf-help-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(expand-matrix)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(template)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(custom-provider)
_arguments "${_arguments_options[@]}" : \
":: :_rtf__help__custom-provider_commands" \
"*::: :->custom-provider" \
&& ret=0

    case $state in
    (custom-provider)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rtf-help-custom-provider-command-$line[1]:"
        case $line[1] in
            (template)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(run)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(test)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_rtf_commands] )) ||
_rtf_commands() {
    local commands; commands=(
'run:Check and run a test plan' \
'expand-matrix:Expand a test plan matrix into JSON' \
'template:Template a test plan using provided variables, outputting the resulting config to stdout' \
'custom-provider:Work directly with custom file provider definitions' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'rtf commands' commands "$@"
}
