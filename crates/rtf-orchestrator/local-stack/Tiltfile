load("ext://secret", "secret_from_dict")

# We only have ~10 resources in this file. This ensures that anything that can be worked on
# can be worked on
update_settings(max_parallel_updates=6)

allow_k8s_contexts("kind-rtf-mgmt")

config.define_bool("orchestrator-tests", args=False, usage="Run all cargo tests for the orchestrator crate (off by default)")
config.define_bool("ui", args=False, usage="Build and deploy the orchestrator status UI (off by default; not part of CI/integration tests)")
cfg = config.parse()
run_orchestrator_tests = cfg.get("orchestrator-tests", False)
run_ui = cfg.get("ui", False)

# NodePort values — must match the values in values-local.yaml and k8s/mock-backend.yaml
ORCH_NODEPORT = 30035
MOCK_BACKEND_NODEPORT = 30080

# Extract container IPs for both clusters on the kind network.
# These are reachable from pods in the management cluster since both kind clusters
# share the same docker network.
workload_ip = str(
    local(
        "docker inspect rtf-workload-control-plane"
        + " --format '{{ .NetworkSettings.Networks.kind.IPAddress }}'",
        quiet=True,
    )
).strip()

mgmt_ip = str(
    local(
        "docker inspect rtf-mgmt-control-plane"
        + " --format '{{ .NetworkSettings.Networks.kind.IPAddress }}'",
        quiet=True,
    )
).strip()

# Get the workload kubeconfig and rewrite the server address to use the container
# IP (port 6443) rather than the localhost port-forward.
workload_kubeconfig = str(
    local(
        "kind get kubeconfig --name rtf-workload"
        + " | sed 's|https://127.0.0.1:[0-9]*|https://%s:6443|g'" % workload_ip,
        quiet=True,
    )
)

# Namespaces
k8s_yaml("k8s/namespace.yaml")

# Admins allowlist — mounted into the orchestrator pod for validating admin actions
k8s_yaml("k8s/admins.yaml")

# Workload kubeconfig — stored as a secret so Argo workflow pods can reach the workload cluster
k8s_yaml(
    secret_from_dict(
        "orchestrator-kubeconfig",
        namespace="cluster-api",
        inputs={"value": workload_kubeconfig},
    )
)

# Workload kubeconfig — mounted into the orchestrator pod so it can reach the workload cluster
#                       (access to the management cluster uses the in-cluster config)
k8s_yaml(
    secret_from_dict(
        "orchestrator-kubeconfig",
        namespace="orchestrator",
        inputs={"config": workload_kubeconfig},
    )
)

# GitHub App private key — dummy value; the orchestrator doesn't validate the PEM at startup,
# only at JWT signing time. GitHub calls will fail if actually attempted.
k8s_yaml(
    secret_from_dict(
        "github-app-private-key",
        namespace="orchestrator",
        inputs={"private-key-pem": "dummy"},
    )
)

# rtf-orchestrator secret — dev values now owned by Tilt rather than the Helm chart.
# apollo-key and github-app-id were previously sourced from values.yaml/values-local.yaml.
k8s_yaml(
    secret_from_dict(
        "rtf-orchestrator",
        namespace="orchestrator",
        inputs={
            "apollo-key": "dummy",
            "github-app-id": "1",
            "db-pass": "password",
        },
    )
)

# Make sure the rtf-toolbox image is available on both clusters under its local tag.
# values-local.yaml points toolboxImage.repository/tag at this same "rtf-toolbox:edge" image, so
# no re-tagging to the full registry path is needed.
# We split this into two so we can load the image to each cluster in parallel.
TOOLBOX_IMAGE = "rtf-toolbox:edge"
local_resource(
    "toolbox-image-mgmt",
    cmd="kind load docker-image {img} --name rtf-mgmt".format(img=TOOLBOX_IMAGE),
    allow_parallel=True,
    labels=["infra"],
)

local_resource(
    "toolbox-image-workload",
    cmd="kind load docker-image {img} --name rtf-workload".format(img=TOOLBOX_IMAGE),
    allow_parallel=True,
    labels=["infra"],
)

# Argo workflow service account + RBAC in cluster-api
k8s_yaml("k8s/service-account.yaml")
k8s_resource(
    objects=[
        "cluster-api:namespace",
        "orchestrator:namespace",
        "argo-workflow:serviceaccount:cluster-api",
        "argo-workflow:role:cluster-api",
        "argo-workflow:rolebinding:cluster-api",
        "orchestrator-kubeconfig:secret:cluster-api",
        "orchestrator-kubeconfig:secret:orchestrator",
        "github-app-private-key:secret:orchestrator",
        "rtf-orchestrator:secret:orchestrator",
        "orchestrator-admins:configmap:orchestrator",
        "orchestrator-workflow-submitter:role:cluster-api",
        "orchestrator-workflow-submitter:rolebinding:cluster-api",
    ],
    new_name="cluster-setup",
    labels=["infra"],
)

# Argo Workflows
ARGO_WORKFLOWS_VERSION = "v3.6.5"
ARGO_INSTALL_URL = (
    "https://github.com/argoproj/argo-workflows/releases/download/%s/quick-start-minimal.yaml"
    % ARGO_WORKFLOWS_VERSION
)

k8s_resource(
    objects=["argo:namespace"],
    new_name="argo-namespace",
    labels=["infra"],
)

# Parallelism is explicitly enabled here since the Argo install does not depend on the toolbox
# image being loaded (the only other local resources)
# By default, tilt will load all local resources before loading k8s resources. This ensures the local
# resources load as quickly as possible so the k8s resources can start loading
# https://docs.tilt.dev/resource_dependencies.html
local_resource(
    "argo-install",
    cmd="kubectl apply -n argo --server-side --context kind-rtf-mgmt -f "
    + ARGO_INSTALL_URL
    + " && kubectl -n argo rollout status --context kind-rtf-mgmt deployment/workflow-controller --timeout=120s",
    resource_deps=["argo-namespace"],
    allow_parallel=True,
    labels=["infra"],
)

# PostgreSQL (local only — not part of rtf-orchestrator Helm chart)
k8s_yaml(helm(
    "helm/postgres",
    name="postgres",
    namespace="orchestrator",
    values=["helm/postgres/values.yaml"],
))
k8s_resource("postgres", port_forwards=["5432:5432"], resource_deps=["postgres-config"], labels=["rtf-orchestrator"])
k8s_resource(
    objects=[
        "postgres:serviceaccount:orchestrator",
        "postgres:secret:orchestrator",
        "postgres:poddisruptionbudget:orchestrator",
        "postgres:networkpolicy:orchestrator",
    ],
    new_name="postgres-config",
    resource_deps=["cluster-setup"],
    labels=["rtf-orchestrator"],
)

# Image build — custom_build separates file watching (deps/ignore) from the Docker
# build context, so we can exclude test directories from triggering rebuilds without
# stripping them from the context that cargo needs.
# target/ and .git/ are excluded from the Docker context via .dockerignore at the repo root.
custom_build(
    "rtf-orchestrator",
    "docker build --file ../docker/Dockerfile --build-arg GIT_SHA=$(git rev-parse --short HEAD) --tag $EXPECTED_REF ../../../",
    deps=[
        "../../../Cargo.lock",
        "../../../Cargo.toml",
        "../../../crates/",
    ],
    ignore=[
        "../../../crates/rtf-cli/resources/",  # test fixtures only — reading these during integration tests triggers spurious rebuilds via MacOS FSEvents atime updates
        "../../../crates/rtf-orchestrator/tests/",  # integration tests are not compiled into the release binary
    ],
)

# Orchestrator status UI — a standalone service that reaches the orchestrator in-cluster via its
# ClusterIP service (values-local.yaml sets RTF_UI_ORCHESTRATOR_URL to http://rtf-orchestrator:8035),
# mirroring production. Templates and htmx are embedded in the binary, so no assets are mounted.
# Opt-in via `tilt up -- --ui` (or set "ui" in tilt_config.json); off by default so it is not built
# or deployed in CI, where it is not exercised. Browse it on http://localhost:8081/ui when enabled
# (8080 is taken by the mock-backend port-forward).
if run_ui:
    custom_build(
        "rtf-orchestrator-ui",
        "docker build --file ../../rtf-orchestrator-ui/docker/Dockerfile --tag $EXPECTED_REF ../../../",
        deps=[
            "../../../Cargo.lock",
            "../../../Cargo.toml",
            "../../../crates/",
        ],
        ignore=[
            "../../../crates/rtf-cli/resources/",  # test fixtures only — reading these during integration tests triggers spurious rebuilds via MacOS FSEvents atime updates
            "../../../crates/rtf-orchestrator/tests/",  # integration tests are not compiled into the release binary
        ],
    )

# Mock backend server — in-memory GCS store plus a fake Prometheus query_range endpoint, used in
# place of the real services for local integration tests
custom_build(
    "mock-backend",
    "docker build --file ../../../mock-backend/Dockerfile --tag $EXPECTED_REF ../../../mock-backend",
    deps=[
        "../../../mock-backend/",
    ],
)
k8s_yaml("k8s/mock-backend.yaml")
k8s_resource(
    "mock-backend",
    port_forwards=["8080:8080"],
    resource_deps=["cluster-setup"],
    labels=["rtf-orchestrator"]
)

# Helm deploy — DB connection wired to local postgres service.
# orchestratorUrl, gcs.mockInternalUrl, and prometheus.endpoint use the mgmt cluster container IP
# so they are reachable from workload cluster pods as well as from within the mgmt cluster.
k8s_yaml(helm(
    "../helm/rtf-orchestrator",
    name="rtf-orchestrator",
    namespace="orchestrator",
    values=[
        "../helm/rtf-orchestrator/values.yaml",
        "../helm/rtf-orchestrator/values-local.yaml",
    ],
    set=[
        "db.host=postgres",
        "config.orchestratorUrl=http://%s:%s" % (mgmt_ip, ORCH_NODEPORT),
        "gcs.mockInternalUrl=http://%s:%s/gcs" % (mgmt_ip, MOCK_BACKEND_NODEPORT),
        "prometheus.endpoint=http://%s:%s" % (mgmt_ip, MOCK_BACKEND_NODEPORT),
    ],
))

k8s_resource(
    "rtf-orchestrator",
    port_forwards=["8035:8035"],
    resource_deps=["cluster-setup"],
    labels=["rtf-orchestrator"],
)

# Orchestrator status UI deploy — gated on the same `--ui` flag as its image build above.
if run_ui:
    k8s_yaml(helm(
        "../../rtf-orchestrator-ui/helm/rtf-orchestrator-ui",
        name="rtf-orchestrator-ui",
        namespace="orchestrator",
        values=[
            "../../rtf-orchestrator-ui/helm/rtf-orchestrator-ui/values.yaml",
            "../../rtf-orchestrator-ui/helm/rtf-orchestrator-ui/values-local.yaml",
        ],
    ))

    k8s_resource(
        "rtf-orchestrator-ui",
        port_forwards=["8081:8080"],
        resource_deps=["cluster-setup"],
        labels=["rtf-orchestrator"],
    )

if run_orchestrator_tests:
    local_resource(
        "orchestrator-tests",
        cmd="make -C ../ test-all",
        resource_deps=["rtf-orchestrator"],
        labels=["test"],
    )
