load("ext://secret", "secret_from_dict")

allow_k8s_contexts("kind-rtf-mgmt")

config.define_bool("orchestrator-tests", args=False, usage="Run all cargo tests for the orchestrator crate (off by default)")
cfg = config.parse()
run_orchestrator_tests = cfg.get("orchestrator-tests", False)

# NodePort values — must match the values in values-local.yaml and k8s/mock-gcs.yaml
ORCH_NODEPORT = 30035
MOCK_GCS_NODEPORT = 30080

# Extract container IPs for both clusters on the kind network.
# These are reachable from pods in the management cluster since both kind clusters
# share the same docker network.
workload_ip = str(
    local(
        "docker inspect rtf-workload-control-plane"
        + " --format '{{ .NetworkSettings.Networks.kind.IPAddress }}'",
        quiet=True,
    )
).strip()

mgmt_ip = str(
    local(
        "docker inspect rtf-mgmt-control-plane"
        + " --format '{{ .NetworkSettings.Networks.kind.IPAddress }}'",
        quiet=True,
    )
).strip()

# Get the workload kubeconfig and rewrite the server address to use the container
# IP (port 6443) rather than the localhost port-forward.
workload_kubeconfig = str(
    local(
        "kind get kubeconfig --name rtf-workload"
        + " | sed 's|https://127.0.0.1:[0-9]*|https://%s:6443|g'" % workload_ip,
        quiet=True,
    )
)

# Build a combined kubeconfig (both clusters, container IPs) for the orchestrator pod.
# Written via temp files to avoid shell quoting issues with YAML content.
combined_kubeconfig = str(
    local(
        "kind get kubeconfig --name rtf-mgmt"
        + " | sed 's|https://127.0.0.1:[0-9]*|https://%s:6443|g' > /tmp/rtf-mgmt.kubeconfig" % mgmt_ip
        + " && kind get kubeconfig --name rtf-workload"
        + " | sed 's|https://127.0.0.1:[0-9]*|https://%s:6443|g' > /tmp/rtf-workload.kubeconfig" % workload_ip
        + " && KUBECONFIG=/tmp/rtf-mgmt.kubeconfig:/tmp/rtf-workload.kubeconfig kubectl config view --flatten --merge",
        quiet=True,
    )
)

# Namespaces
k8s_yaml("k8s/namespace.yaml")

# Workload kubeconfig — stored as a secret so Argo workflow pods can reach the workload cluster
k8s_yaml(
    secret_from_dict(
        "orchestrator-kubeconfig",
        namespace="cluster-api",
        inputs={"value": workload_kubeconfig},
    )
)

# Combined kubeconfig — mounted into the orchestrator pod so it can reach both clusters
k8s_yaml(
    secret_from_dict(
        "orchestrator-kubeconfig",
        namespace="orchestrator",
        inputs={"config": combined_kubeconfig},
    )
)

# GitHub App private key — dummy value; the orchestrator doesn't validate the PEM at startup,
# only at JWT signing time. GitHub calls will fail if actually attempted.
k8s_yaml(
    secret_from_dict(
        "github-app-private-key",
        namespace="orchestrator",
        inputs={"private-key-pem": "dummy"},
    )
)

# Make sure the rtf-toolbox image is available on both clusters under its full registry name.
# The workflow spec references the full GCR path, so the image must be loaded under that name
# even though it was built locally as rtf-toolbox:edge.
TOOLBOX_IMAGE = "us-central1-docker.pkg.dev/platform-cross-environment/apollo-private-docker/rtf-toolbox:edge"
local_resource(
    "toolbox-image",
    cmd=(
        "docker tag rtf-toolbox:edge {img}"
        + " && kind load docker-image {img} --name rtf-mgmt"
        + " && kind load docker-image {img} --name rtf-workload"
    ).format(img=TOOLBOX_IMAGE),
    labels=["infra"],
)

# GCR pull secret — dummy for local use. In production this contains real GCR credentials
# used by create-pull-secret to authorise image pulls in the workload cluster. Locally,
# all test fixtures use public images, so the credential content is irrelevant; the secret
# object must exist so Argo can mount it into the create-pull-secret workflow task pod.
k8s_yaml(
    secret_from_dict(
        "gcr-secret",
        namespace="cluster-api",
        inputs={".dockerconfigjson": '{"auths":{}}'},
    )
)

# Argo workflow service account + RBAC in cluster-api
k8s_yaml("k8s/service-account.yaml")
k8s_resource(
    objects=[
        "cluster-api:namespace",
        "orchestrator:namespace",
        "argo-workflow:serviceaccount:cluster-api",
        "argo-workflow:role:cluster-api",
        "argo-workflow:rolebinding:cluster-api",
        "orchestrator-kubeconfig:secret:cluster-api",
        "orchestrator-kubeconfig:secret:orchestrator",
        "github-app-private-key:secret:orchestrator",
        "gcr-secret:secret:cluster-api",
    ],
    new_name="cluster-setup",
    labels=["infra"],
)

# Argo Workflows
ARGO_WORKFLOWS_VERSION = "v3.6.5"
ARGO_INSTALL_URL = (
    "https://github.com/argoproj/argo-workflows/releases/download/%s/quick-start-minimal.yaml"
    % ARGO_WORKFLOWS_VERSION
)

k8s_resource(
    objects=["argo:namespace"],
    new_name="argo-namespace",
    labels=["infra"],
)

local_resource(
    "argo-install",
    cmd="kubectl apply -n argo --server-side --context kind-rtf-mgmt -f "
    + ARGO_INSTALL_URL
    + " && kubectl -n argo rollout status --context kind-rtf-mgmt deployment/workflow-controller --timeout=120s",
    resource_deps=["argo-namespace"],
    labels=["infra"],
)

# PostgreSQL (local only — not part of rep-orchestrator Helm chart)
k8s_yaml(helm(
    "helm/postgres",
    name="postgres",
    namespace="orchestrator",
    values=["helm/postgres/values.yaml"],
))
k8s_resource("postgres", port_forwards=["5432:5432"], resource_deps=["postgres-config"], labels=["rep-orchestrator"])
k8s_resource(
    objects=[
        "postgres:serviceaccount:orchestrator",
        "postgres:secret:orchestrator",
        "postgres:poddisruptionbudget:orchestrator",
        "postgres:networkpolicy:orchestrator",
    ],
    new_name="postgres-config",
    resource_deps=["cluster-setup"],
    labels=["rep-orchestrator"],
)

# Image build — custom_build separates file watching (deps/ignore) from the Docker
# build context, so we can exclude test directories from triggering rebuilds without
# stripping them from the context that cargo needs.
# target/ and .git/ are excluded from the Docker context via .dockerignore at the repo root.
custom_build(
    "rep-orchestrator",
    "docker build --file ../docker/Dockerfile --tag $EXPECTED_REF ../../../",
    deps=[
        "../../../Cargo.lock",
        "../../../Cargo.toml",
        "../../../crates/",
    ],
    ignore=[
        "../../../crates/rtf-cli/resources/",  # test fixtures only — reading these during integration tests triggers spurious rebuilds via MacOS FSEvents atime updates
        "../../../crates/rep-orchestrator/tests/",  # integration tests are not compiled into the release binary
    ],
)

# Mock GCS server — in-memory store used in place of real GCS for local integration tests
custom_build(
    "mock-gcs",
    "docker build --file ../../../mock-gcs/Dockerfile --tag $EXPECTED_REF ../../../mock-gcs",
    deps=[
        "../../../mock-gcs/",
    ],
)
k8s_yaml("k8s/mock-gcs.yaml")
k8s_resource(
    "mock-gcs",
    port_forwards=["8080:8080"],
    resource_deps=["cluster-setup"],
    labels=["rep-orchestrator"]
)

# Helm deploy — DB connection wired to local postgres service.
# orchestratorUrl and gcs.mockUrl use the mgmt cluster container IP so they are
# reachable from workload cluster pods as well as from within the mgmt cluster.
k8s_yaml(helm(
    "../helm/rep-orchestrator",
    name="rep-orchestrator",
    namespace="orchestrator",
    values=[
        "../helm/rep-orchestrator/values.yaml",
        "../helm/rep-orchestrator/values-local.yaml",
    ],
    set=[
        "db.host=postgres",
        "config.orchestratorUrl=http://%s:%s" % (mgmt_ip, ORCH_NODEPORT),
        "gcs.mockInternalUrl=http://%s:%s" % (mgmt_ip, MOCK_GCS_NODEPORT),
    ],
))

k8s_resource(
    "rep-orchestrator",
    objects=["rep-orchestrator:secret:orchestrator"],
    port_forwards=["8035:8035"],
    resource_deps=["cluster-setup", "postgres", "argo-install", "mock-gcs"],
    labels=["rep-orchestrator"],
)

if run_orchestrator_tests:
    local_resource(
        "orchestrator-tests",
        cmd="make -C ../ test-all",
        resource_deps=["rep-orchestrator"],
        labels=["test"],
    )
