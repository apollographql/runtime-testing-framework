---
source: crates/rtf-orchestrator-ui/src/templates/test_plan_detail.rs
expression: "render_fragment!(preview::test_plan_detail().as_trigger_form())"
---


<h2>Trigger a run</h2>








<section class="card" id="trigger-section">
    <form method="get" action="/ui/test-plan/00000000-0000-0000-0000-00000000000a" class="ref-row">
        <input type="hidden" name="days_back" value="30" />
        <input type="hidden" name="days" value="30" />
        <label for="ref-preview"><strong>Ref</strong></label>
        <input id="ref-preview" name="trigger_ref" type="text" placeholder="main" value="" size="32" />
        <button type="submit" class="secondary">Load ref</button>
        <span class="muted">Branch, tag or SHA (defaults to the default branch). Variables and defaults below come from this ref.</span>
    </form>

    <div id="load-banner"></div>

    <div class="sub-head">
        <h3>Changed variables</h3>
        <span class="muted" id="changed-count"></span>
    </div>
    <div id="overrides"></div>
    <div class="add-var-row">
        <div class="picker-wrap">
            <button type="button" class="secondary" id="add-var">+ Change a variable</button>
            <div class="picker" id="picker" hidden>
                <input id="picker-q" type="search" placeholder="Search variables by name or description" autocomplete="off" aria-label="Search variables" />
                <ul id="picker-list"></ul>
            </div>
        </div>
        <span class="muted">Add several values to run a variable as a matrix dimension.</span>
    </div>

    <div class="sub-head">
        <h3>Compound dimensions</h3>
        <span class="muted">Variables that vary together &mdash; only the listed combinations run.</span>
    </div>
    <div id="groups"></div>
    <div id="new-group-slot"></div>
    <button type="button" class="secondary" id="new-group-btn">+ New compound dimension</button>

    <details id="defaults" style="margin-top:1.4rem">
        <summary>Using test plan defaults <span class="muted" id="defaults-count"></span></summary>
        <table class="defaults-table">
            <thead>
                <tr>
                    <th>Variable</th>
                    <th>Value</th>
                    <th>Description</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="defaults-body"></tbody>
        </table>
    </details>

    <details id="raw-variables" style="margin-top:0.75rem">
        <summary>Raw variables JSON</summary>
        <p class="muted" style="margin-bottom:0.3rem;">Generated from the form and submitted as-is. Edit and apply to load JSON into the form (e.g. copied from a previous run).</p>
        <textarea id="variables" name="variables" form="trigger-form" rows="9"></textarea>
        <p style="margin:0.4rem 0 0"><button type="button" class="secondary" id="apply-json">Apply JSON to form</button> <span id="json-error" class="trigger-problems"></span></p>
    </details>
</section>

<form method="post" action="/ui/test-plan/00000000-0000-0000-0000-00000000000a/trigger" id="trigger-form">
    <input type="hidden" name="ref" value="" />
    <input type="hidden" name="days_back" value="30" />
    <input type="hidden" name="days" value="30" />
</form>

<div class="trigger-bar">
    <div class="trigger-bar__inner">
        <div><span class="trigger-bar__count" id="trigger-total">8</span> executions<br><span class="muted" id="trigger-formula">2 region × 2 colours × 2 subjects</span></div>
        <div class="trigger-problems" id="trigger-problems"></div>
        <span class="spacer"></span>
        <button type="button" class="secondary" id="variants-btn">Preview executions</button>
        <button type="submit" form="trigger-form" class="primary" id="trigger-btn" >Trigger <span id="trigger-count">8</span> executions</button>
    </div>
</div>

<dialog id="variants-dialog">
    <h3 id="variants-title"></h3>
    <p class="muted" id="variants-sub"></p>
    <div class="dialog-scroll"><table id="variants-table"></table></div>
    <div class="dialog-actions"><button type="button" class="secondary" data-close-dialog>Close</button></div>
</dialog>

<div class="toast" id="toast" role="status" aria-live="polite"></div>
