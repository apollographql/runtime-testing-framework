    </p>
    <div class="plan-config">
        <dl>
            
            <dt>Commit</dt>
            <dd><code>abc1234def5678</code></dd>
            <dt>Workload Pool</dt>
            <dd><code>dedicated</code></dd>
            
            <dt>Pinned workload pool</dt>
            <dd><code>dedicated</code></dd>
            <dt>Dedicated cluster</dt>
            <dd>Required</dd>
            
            <dt>Node label weights</dt>
            <dd><code>rtf.io/node-pool-a</code>: 3, <code>rtf.io/node-pool-b</code>: 1</dd>
            
            <dt>Namespace write access</dt>
            <dd>Enabled</dd>
        </dl>
        <dl>
            <dt>Triggers</dt>
            <dd>Restricted to owners and trigger users</dd>
            <dt>Automated triggers</dt>
            <dd>Disabled</dd>
            <dt>Owners</dt>
            <dd>owner@apollographql.com</dd>
            <dt>Trigger users</dt>
            <dd>trigger-user@apollographql.com</dd>
        </dl>
    </div>
