---
source: crates/rtf-orchestrator-ui/src/templates/test_plan_detail.rs
expression: "render_fragment!(preview::test_plan_detail_k8s().as_overview())"
---


<div class="detail-grid">
    <div class="detail-main">

        <section class="banner">
            <h2>Overview</h2>
            <dl>
                <dt>Executions per run at test plan defaults</dt>
                <dd id="stat-executions">8</dd>
                <dd class="muted" id="stat-formula">2 region × 2 colours × 2 subjects</dd>

                <dt>Variables</dt>
                <dd>8 variables · 1 matrix dimension · 2 compound dimensions</dd>
            </dl>
        </section>

        
        
        <h2>Kubernetes manifests</h2>
        <p class="muted">This environment applies whatever is in these manifests to the cluster namespace &mdash; open them on GitHub to see exactly what will be deployed.</p>
        
        
        <p class="muted">Different matrix combinations may use different manifests.</p>
        
        
        <div class="info-box">
            <b>Some manifests will be set by required variables.</b>
            
        </div>
        
        <ol>
            
            <li>
                
                <a href="https://github.com/apollographql/runtime-testing-framework/blob/main/k8s/deployment.yaml" target="_blank" rel="noopener noreferrer"><code>deployment.yaml</code> &#8599;</a>
                
                
            </li>
            
            <li>
                
                <code>worker.yaml</code>
                <span class="muted">(set by required variable: <code>worker_overlay</code>)</span>
                
            </li>
            
            <li>
                
                <a href="https://github.com/apollographql/runtime-testing-framework/blob/main/k8s/service.yaml" target="_blank" rel="noopener noreferrer"><code>service.yaml</code> &#8599;</a>
                
                
            </li>
            
            <li>
                
                <a href="https://github.com/apollographql/runtime-testing-framework/blob/main/test-plans/example.yaml" target="_blank" rel="noopener noreferrer"><code>kustomization.yaml</code> &#8599;</a>
                
                <span class="muted">(inline in the environment config)</span>
                
                
            </li>
            
        </ol>
        

    </div>

    <div class="detail-side">
        <div class="card">
            <h3>Previous runs</h3>
            <p class="muted">
                <a href="/ui/test-plan/00000000-0000-0000-0000-00000000000a?days_back=60" aria-label="Previous history window">&larr;</a>
                1970-01-01 &ndash; 1969-12-31
                
                <a href="/ui/test-plan/00000000-0000-0000-0000-00000000000a?days_back=0" aria-label="Next history window">&rarr;</a>
                
            </p>
            <canvas id="chart-status" height="170"></canvas>
        </div>
        <div class="card">
            <h3>Historic execution duration (mm:ss)</h3>
            <p class="muted">
                <a href="/ui/test-plan/00000000-0000-0000-0000-00000000000a?days_back=60" aria-label="Previous history window">&larr;</a>
                0 runs in the last 30 days
                
                <a href="/ui/test-plan/00000000-0000-0000-0000-00000000000a?days_back=0" aria-label="Next history window">&rarr;</a>
                
            </p>
            <canvas id="chart-duration" height="170"></canvas>
        </div>
    </div>
</div>
